local function rrotate(x: number, n: number): number
    return bit32.bor(bit32.rshift(x, n), bit32.lshift(x, 32 - n))
end

local function sha256Bytes(msg: string): string
    local H: {number} = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}
    local bitLen: number = #msg * 8
    msg = msg .. "\128"
    while (#msg % 64) ~= 56 do
        msg = msg .. "\0"
    end
    local lenBytes: {string} = {}
    for i = 7, 0, -1 do
        lenBytes[#lenBytes + 1] = string.char(math.floor(bitLen / (2 ^ (i * 8))) % 256)
    end
    msg = msg .. table.concat(lenBytes)

    for chunkStart = 1, #msg, 64 do
        local w: {number} = {}
        for i = 0, 15 do
            local base = chunkStart + i * 4
            local b1, b2, b3, b4 = string.byte(msg, base, base + 3)
            w[i] = bit32.bor(bit32.lshift(b1 :: number, 24), bit32.lshift(b2 :: number, 16), bit32.lshift(b3 :: number, 8), b4 :: number)
        end
        for i = 16, 63 do
            local s0 = bit32.bxor(rrotate(w[i - 15], 7), rrotate(w[i - 15], 18), bit32.rshift(w[i - 15], 3))
            local s1 = bit32.bxor(rrotate(w[i - 2], 17), rrotate(w[i - 2], 19), bit32.rshift(w[i - 2], 10))
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 4294967296
        end
        local a, b, c, d, e, f, g, h = H[1], H[2], H[3], H[4], H[5], H[6], H[7], H[8]
        for i = 0, 63 do
            local S1 = bit32.bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
            local ch = bit32.bxor(bit32.band(e, f), bit32.band(bit32.bnot(e), g))
            local t1 = (h + S1 + ch + K[i + 1] + w[i]) % 4294967296
            local S0 = bit32.bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
            local maj = bit32.bxor(bit32.band(a, b), bit32.band(a, c), bit32.band(b, c))
            local t2 = (S0 + maj) % 4294967296
            h = g; g = f; f = e
            e = (d + t1) % 4294967296
            d = c; c = b; b = a
            a = (t1 + t2) % 4294967296
        end
        H[1] = (H[1] + a) % 4294967296
        H[2] = (H[2] + b) % 4294967296
        H[3] = (H[3] + c) % 4294967296
        H[4] = (H[4] + d) % 4294967296
        H[5] = (H[5] + e) % 4294967296
        H[6] = (H[6] + f) % 4294967296
        H[7] = (H[7] + g) % 4294967296
        H[8] = (H[8] + h) % 4294967296
    end
    local out: {string} = {}
    for i = 1, 8 do
        out[#out + 1] = string.char(
            math.floor(H[i] / 16777216) % 256,
            math.floor(H[i] / 65536) % 256,
            math.floor(H[i] / 256) % 256,
            H[i] % 256
        )
    end
    return table.concat(out)
end

function SecureCrypto.sha256(msg: string): string
    return bytesToHex(sha256Bytes(msg))
end

local function hmacSha256Bytes(key: string, msg: string): string
    local blockSize = 64
    if #key > blockSize then
        key = sha256Bytes(key)
    end
    if #key < blockSize then
        key = key .. string.rep("\0", blockSize - #key)
    end
    local ipad: {string} = {}
    local opad: {string} = {}
    for i = 1, blockSize do
        local b = string.byte(key, i) :: number
        ipad[i] = string.char(bit32.bxor(b, 0x36))
        opad[i] = string.char(bit32.bxor(b, 0x5c))
    end
    return sha256Bytes(table.concat(opad) .. sha256Bytes(table.concat(ipad) .. msg))
end

function SecureCrypto.hmacSha256(key: string, msg: string): string
    return bytesToHex(hmacSha256Bytes(key, msg))
end

function SecureCrypto.pbkdf2(password: string, salt: string, iterations: number?, dkLen: number?): string
    local iters: number = iterations or 10000
    local keyLen: number = dkLen or 16
    assert(type(iters) == "number" and iters >= 1, "iterations must be >= 1")
    assert(type(keyLen) == "number" and keyLen >= 1, "dkLen must be >= 1")
    local blocks = math.ceil(keyLen / 32)
    local out: {string} = {}
    for i = 1, blocks do
        local blockIndex = string.char(
            math.floor(i / 16777216) % 256,
            math.floor(i / 65536) % 256,
            math.floor(i / 256) % 256,
            i % 256
        )
        local U = hmacSha256Bytes(password, salt .. blockIndex)
        local T: {number} = {string.byte(U, 1, #U)}
        for _ = 2, iters do
            U = hmacSha256Bytes(password, U)
            local ub: {number} = {string.byte(U, 1, #U)}
            for j = 1, #T do
                T[j] = bit32.bxor(T[j], ub[j])
            end
        end
        local blockOut: {string} = {}
        for j = 1, #T do
            blockOut[j] = string.char(T[j])
        end
        out[#out + 1] = table.concat(blockOut)
    end
    return table.concat(out):sub(1, keyLen)
end

function SecureCrypto.newIV(): string
    local iv = getRng()(16)
    assert(type(iv) == "string" and #iv == 16, "random source must return 16 bytes")
    return iv
end

function SecureCrypto.ivToHex(iv: string): string
    assert(type(iv) == "string" and #iv == 16, "iv must be 16 bytes")
    return bytesToHex(iv)
end

function SecureCrypto.ivFromHex(hex: string): string
    assert(type(hex) == "string" and #hex == 32 and hex:match("^%x+$") ~= nil, "iv hex must be 32 hex chars")
    return hexToBytes(hex)
end

