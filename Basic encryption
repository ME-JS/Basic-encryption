--!strict
local SecureCrypto = {}

type RandomSource = (number) -> string

local randomSource: RandomSource? = nil
local rng: Random? = nil

local function getRng(): RandomSource
    if randomSource then
        return randomSource :: RandomSource
    end
    if not rng then
        rng = Random.new()
    end
    local r = rng :: Random
    return function(n: number): string
        local t: {string} = {}
        for i = 1, n do
            t[i] = string.char(r:NextInteger(0, 255))
        end
        return table.concat(t)
    end
end

function SecureCrypto.setRandomSource(fn: RandomSource?)
    assert(type(fn) == "function" or fn == nil)
    randomSource = fn
end

local function hexToBytes(hex: string): string
    return (hex:gsub("%x%x", function(h: string): string
        return string.char(tonumber(h, 16) :: number)
    end))
end

local function bytesToHex(s: string): string
    return (s:gsub(".", function(c: string): string
        return string.format("%02x", string.byte(c) :: number)
    end))
end

