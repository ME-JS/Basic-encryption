local INV_SBOX: {number} = {}
for i, v in ipairs(SBOX) do
    INV_SBOX[v] = i - 1
end

local RCON: {number} = {0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36}

local INV_M: {{number}} = {
    {14,11,13, 9},
    { 9,14,11,13},
    {13, 9,14,11},
    {11,13, 9,14},
}

local function mul(a: number, b: number): number
    local p = 0
    for _ = 1, 8 do
        if bit32.band(b, 1) == 1 then
            p = bit32.bxor(p, a)
        end
        local hi = bit32.band(a, 0x80)
        a = bit32.lshift(a, 1)
        if hi ~= 0 then
            a = bit32.bxor(a, 0x1b)
        end
        a = bit32.band(a, 0xff)
        b = bit32.rshift(b, 1)
    end
    return p
end

local function keyExpansion(key: string): {{number}}
    local w: {{number}} = {}
    for i = 0, 3 do
        w[i] = {
            string.byte(key, i * 4 + 1) :: number,
            string.byte(key, i * 4 + 2) :: number,
            string.byte(key, i * 4 + 3) :: number,
            string.byte(key, i * 4 + 4) :: number,
        }
    end
    for i = 4, 43 do
        local temp: {number} = {table.unpack(w[i - 1])}
        if i % 4 == 0 then
            local t = temp[1]
            temp[1], temp[2], temp[3], temp[4] = temp[2], temp[3], temp[4], t
            for j = 1, 4 do
                temp[j] = SBOX[temp[j] + 1]
            end
            temp[1] = bit32.bxor(temp[1], RCON[i // 4])
        end
        w[i] = {}
        for j = 1, 4 do
            w[i][j] = bit32.bxor(w[i - 4][j], temp[j])
        end
    end
    return w
end

local function addRoundKey(state: {{number}}, w: {{number}}, round: number)
    for c = 0, 3 do
        for r = 0, 3 do
            state[c][r] = bit32.bxor(state[c][r], w[round * 4 + c + 1][r + 1])
        end
    end
end

local function subBytes(state: {{number}}, box: {number})
    for c = 0, 3 do
        for r = 0, 3 do
            state[c][r] = box[state[c][r] + 1]
        end
    end
end

local function shiftRows(state: {{number}}, inv: boolean)
    for r = 1, 3 do
        local row: {number} = {}
        for c = 0, 3 do
            row[c] = state[c][r]
        end
        for c = 0, 3 do
            local nc = inv and (c - r) % 4 or (c + r) % 4
            state[c][r] = row[nc]
        end
    end
end

local function mixColumns(state: {{number}}, inv: boolean)
    for c = 0, 3 do
        local a: {number} = {state[c][0], state[c][1], state[c][2], state[c][3]}
        for r = 0, 3 do
            local v = 0
            if inv then
                for k = 0, 3 do
                    v = bit32.bxor(v, mul(a[(r + k) % 4], INV_M[r + 1][k + 1]))
                end
            else
                local m: {number} = {2, 3, 1, 1}
                for k = 0, 3 do
                    v = bit32.bxor(v, mul(a[(r + k) % 4], m[k + 1]))
                end
            end
            state[c][r] = v
        end
    end
end

local function toState(block: string): {{number}}
    local s: {{number}} = {}
    for c = 0, 3 do
        s[c] = {}
        for r = 0, 3 do
            s[c][r] = string.byte(block, c * 4 + r + 1) :: number
        end
    end
    return s
end

local function fromState(s: {{number}}): string
    local out: {string} = {}
    for c = 0, 3 do
        for r = 0, 3 do
            out[#out + 1] = string.char(s[c][r])
        end
    end
    return table.concat(out)
end

local function encryptBlock(block: string, w: {{number}}): string
    local s = toState(block)
    addRoundKey(s, w, 0)
    for round = 1, 9 do
        subBytes(s, SBOX)
        shiftRows(s, false)
        mixColumns(s, false)
        addRoundKey(s, w, round)
    end
    subBytes(s, SBOX)
    shiftRows(s, false)
    addRoundKey(s, w, 10)
    return fromState(s)
end

local function decryptBlock(block: string, w: {{number}}): string
    local s = toState(block)
    addRoundKey(s, w, 10)
    for round = 9, 1, -1 do
        shiftRows(s, true)
        subBytes(s, INV_SBOX)
        addRoundKey(s, w, round)
        mixColumns(s, true)
    end
    shiftRows(s, true)
    subBytes(s, INV_SBOX)
    addRoundKey(s, w, 0)
    return fromState(s)
end

local function xorBlock(a: string, b: string): string
    local out: {string} = {}
    for i = 1, 16 do
        out[i] = string.char(bit32.bxor(string.byte(a, i) :: number, string.byte(b, i) :: number))
    end
    return table.concat(out)
end

local function pad(data: string): string
    local n = 16 - (#data % 16)
    return data .. string.rep(string.char(n), n)
end

local function unpad(data: string): string
    local n = string.byte(data, -1)
    if not n or n < 1 or n > 16 or n > #data then
        error("invalid padding")
    end
    for i = #data - n + 1, #data do
        if string.byte(data, i) ~= n then
            error("invalid padding")
        end
    end
    return data:sub(1, #data - n)
end

function SecureCrypto.aesEncrypt(plain: string, key: string, iv: string): string
    assert(#key == 16, "key must be 16 bytes")
    assert(type(iv) == "string" and #iv == 16, "iv must be 16 bytes")
    local w = keyExpansion(key)
    local data = pad(plain)
    local prev = iv
    local out: {string} = {iv}
    for i = 1, #data, 16 do
        local block = xorBlock(data:sub(i, i + 15), prev)
        local enc = encryptBlock(block, w)
        out[#out + 1] = enc
        prev = enc
    end
    return table.concat(out)
end

function SecureCrypto.aesDecrypt(cipher: string, key: string): string
    assert(#key == 16, "key must be 16 bytes")
    assert(#cipher >= 32 and #cipher % 16 == 0, "cipher too short or not aligned")
    local w = keyExpansion(key)
    local iv = cipher:sub(1, 16)
    local data = cipher:sub(17)
    local prev = iv
    local out: {string} = {}
    for i = 1, #data, 16 do
        local block = data:sub(i, i + 15)
        local dec = decryptBlock(block, w)
        out[#out + 1] = xorBlock(dec, prev)
        prev = block
    end
    return unpad(table.concat(out))
end

local MAC_LABEL = "SecureCrypto-MAC-v1"
local MAC_TAG_LEN = 32

function SecureCrypto.aesEncryptAuthenticated(plain: string, key: string, iv: string): string
    assert(#key == 16, "key must be 16 bytes")
    assert(type(iv) == "string" and #iv == 16, "iv must be 16 bytes")
    local payload = SecureCrypto.aesEncrypt(plain, key, iv)
    local macKey = sha256Bytes(MAC_LABEL .. key)
    local tag = hmacSha256Bytes(macKey, payload)
    return payload .. tag
end

function SecureCrypto.aesDecryptAuthenticated(cipher: string, key: string): string
    assert(#key == 16, "key must be 16 bytes")
    assert(#cipher >= 64 and #cipher % 16 == 0, "cipher too short or not aligned")
    local payload = cipher:sub(1, #cipher - MAC_TAG_LEN)
    local tag = cipher:sub(#cipher - MAC_TAG_LEN + 1)
    local macKey = sha256Bytes(MAC_LABEL .. key)
    local expected = hmacSha256Bytes(macKey, payload)
    local diff = 0
    for i = 1, MAC_TAG_LEN do
        diff = bit32.bor(diff, bit32.bxor(string.byte(tag, i) :: number, string.byte(expected, i) :: number))
    end
    if diff ~= 0 then
        error("MAC verification failed")
    end
    return SecureCrypto.aesDecrypt(payload, key)
end

function SecureCrypto._encryptBlockForTest(block: string, key: string): string
    assert(#block == 16 and #key == 16)
    return encryptBlock(block, keyExpansion(key))
end

function SecureCrypto._decryptBlockForTest(block: string, key: string): string
    assert(#block == 16 and #key == 16)
    return decryptBlock(block, keyExpansion(key))
end

return SecureCrypto
