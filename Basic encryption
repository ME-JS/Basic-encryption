local Obfuscator = {}

local KEYWORDS = {
    ["and"] = true, ["break"] = true, ["do"] = true,
    ["else"] = true, ["elseif"] = true, ["end"] = true,
    ["false"] = true, ["for"] = true, ["function"] = true,
    ["if"] = true, ["in"] = true, ["local"] = true,
    ["nil"] = true, ["not"] = true, ["or"] = true,
    ["repeat"] = true, ["return"] = true, ["then"] = true,
    ["true"] = true, ["until"] = true, ["while"] = true,
    ["continue"] = true, ["export"] = true, ["type"] = true,
}

local function isAlpha(c)
    return c ~= "" and c:match("[%a_]") ~= nil
end

local function isAlnum(c)
    return c ~= "" and c:match("[%w_]") ~= nil
end

local function getLongBracket(source, i)
    if source:sub(i, i) ~= "[" then
        return nil
    end

    local j = i + 1

    while source:sub(j, j) == "=" do
        j = j + 1
    end

    if source:sub(j, j) == "[" then
        return j - i - 1, j + 1
    end

    return nil
end

local function readLong(source, i, level, bodyStart)
    local close = "]" .. string.rep("=", level) .. "]"
    local finish = source:find(close, bodyStart, true)

    if not finish then
        return source:sub(i), #source + 1
    end

    local nextIndex = finish + #close
    return source:sub(i, nextIndex - 1), nextIndex
end

local function decodeQuotedLiteral(literal)
    local body = literal:sub(2, -2)
    local output = {}
    local i = 1

    while i <= #body do
        local c = body:sub(i, i)

        if c ~= "\\" then
            output[#output + 1] = c
            i = i + 1
        else
            local nextChar = body:sub(i + 1, i + 1)

            if nextChar == "" then
                return nil
            elseif nextChar:match("%d") then
                local digits = body:sub(i + 1):match("^(%d%d?%d?)")
                output[#output + 1] =
                    string.char(tonumber(digits) % 256)
                i = i + 1 + #digits
            elseif nextChar == "n" then
                output[#output + 1] = "\n"
                i = i + 2
            elseif nextChar == "r" then
                output[#output + 1] = "\r"
                i = i + 2
            elseif nextChar == "t" then
                output[#output + 1] = "\t"
                i = i + 2
            elseif nextChar == "\\" or nextChar == "'" or nextChar == '"' then
                output[#output + 1] = nextChar
                i = i + 2
            else
                output[#output + 1] = "\\" .. nextChar
                i = i + 2
            end
        end
    end

    return table.concat(output)
end

local function encodeString(value)
    local output = {}

    for i = 1, #value do
        output[#output + 1] =
            "\\" .. string.format("%03d", string.byte(value, i))
    end

    return '"' .. table.concat(output) .. '"'
end

local function tokenize(source)
    local tokens = {}
    local i = 1
    local n = #source

    while i <= n do
        local c = source:sub(i, i)
        local two = source:sub(i, i + 1)

        if c:match("%s") then
            local j = i + 1

            while j <= n and source:sub(j, j):match("%s") do
                j = j + 1
            end

            tokens[#tokens + 1] = {
                kind = "space",
                text = source:sub(i, j - 1)
            }

            i = j

        elseif two == "--" then
            local level, bodyStart =
                getLongBracket(source, i + 2)

            if level ~= nil then
                local text, nextIndex =
                    readLong(source, i, level, bodyStart)

                tokens[#tokens + 1] = {
                    kind = "comment",
                    text = text
                }

                i = nextIndex
            else
                local j = source:find("[\r\n]", i + 2)

                if not j then
                    tokens[#tokens + 1] = {
                        kind = "comment",
                        text = source:sub(i)
                    }

                    i = n + 1
                else
                    tokens[#tokens + 1] = {
                        kind = "comment",
                        text = source:sub(i, j - 1)
                    }

                    i = j
                end
            end

        elseif c == "'" or c == '"' then
            local quote = c
            local j = i + 1

            while j <= n do
                local ch = source:sub(j, j)

                if ch == "\\" then
                    j = j + 2
                elseif ch == quote then
                    j = j + 1
                    break
                else
                    j = j + 1
                end
            end

            tokens[#tokens + 1] = {
                kind = "string",
                text = source:sub(i, math.min(j - 1, n))
            }

            i = j

        elseif c == "[" then
            local level, bodyStart = getLongBracket(source, i)

            if level ~= nil then
                local text, nextIndex =
                    readLong(source, i, level, bodyStart)

                tokens[#tokens + 1] = {
                    kind = "longstring",
                    text = text
                }

                i = nextIndex
            else
                tokens[#tokens + 1] = {
                    kind = "symbol",
                    text = c
                }

                i = i + 1
            end

        elseif isAlpha(c) then
            local j = i + 1

            while j <= n and isAlnum(source:sub(j, j)) do
                j = j + 1
            end

            local word = source:sub(i, j - 1)

            tokens[#tokens + 1] = {
                kind = KEYWORDS[word] and "keyword" or "identifier",
                text = word
            }

            i = j

        elseif c:match("%d") then
            local j = i + 1

            while j <= n and source:sub(j, j):match("[%w%.]") do
                j = j + 1
            end

            tokens[#tokens + 1] = {
                kind = "number",
                text = source:sub(i, j - 1)
            }

            i = j

        else
            tokens[#tokens + 1] = {
                kind = "symbol",
                text = c
            }

            i = i + 1
        end
    end

    return tokens
end

function Obfuscator.Obfuscate(source, options)
    assert(type(source) == "string", "source must be a string")

    options = options or {}

    local tokens = tokenize(source)

    if options.EncodeStrings ~= false then
        for _, token in ipairs(tokens) do
            if token.kind == "string" then
                local decoded = decodeQuotedLiteral(token.text)

                if decoded ~= nil then
                    token.text = encodeString(decoded)
                end
            end
        end
    end

    local output = {}

    for _, token in ipairs(tokens) do
        output[#output + 1] = token.text
    end

    return table.concat(output)
end

return Obfuscator
